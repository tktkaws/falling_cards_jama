---
import SiteNav from "../components/SiteNav.astro";
import Timeline from "../components/Timeline.astro";

const milestones = [
	{ year: "2023", description: "アイデアを形にするところからスタート。小さな試作を重ね、取り組みの方向性を探りました。気づいたことや課題を記録し、対話を通じて整理しながら、次の挑戦につながる土台を築いていきました。" },
	{ year: "2024", description: "最初のプロジェクトを公開。使う人の声を聞きながら、機能やデザインを少しずつ改善しました。実際の利用場面を確かめ、迷いやすい操作や伝わりにくい表現を見直すことで、日々の使いやすさを磨いていきました。" },
	{ year: "2025", description: "新しい技術や表現に挑戦。これまでの経験を生かして、取り組みの幅を広げていきました。試行錯誤から得られた知識を共有し、異なる視点を取り入れることで、より豊かな提案につなげました。" },
	{ year: "2026", description: "積み重ねてきたことを、次の一歩へ。より使いやすく、心地よい体験を目指して進んでいます。これまでの成果を振り返りながら、新たな課題にも丁寧に向き合い、長く使い続けられる仕組みを育てていきます。" },
];
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Falling Cards — Timeline</title>
		<meta name="description" content="中央のタイムラインに沿って、年号と説明文を載せた4枚のカードが左右交互に落下します。" />
	</head>
	<body>
		<SiteNav />
		<header class="masthead">
			<h1>Falling Cards — Timeline</h1>
			<p>年号と説明文を載せたカードが、タイムラインの左右に落ちてきます。</p>
		</header>
		<main>
			<Timeline items={milestones} label="2023年から2026年までのタイムライン" showControls settingsKey="timeline" />
		</main>
	</body>
</html>

<style is:global>
	*, *::before, *::after { box-sizing: border-box; }
	body { margin: 0; background: #fff; color: #1a1a1a; font-family: "Helvetica Neue", "Hiragino Sans", "Noto Sans JP", sans-serif; }
	.masthead { max-width: 1080px; margin: 0 auto; padding: 1.5rem 1.25rem 2rem; }
	.masthead h1 { margin: 0; font-size: 1rem; font-weight: 650; letter-spacing: 0.04em; }
	.masthead p { margin: 0.35rem 0 0; font-size: 0.82rem; line-height: 1.5; color: #555; }
</style>
