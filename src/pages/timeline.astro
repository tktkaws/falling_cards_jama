---
import SiteNav from "../components/SiteNav.astro";

const milestones = [
	{ year: "2023", description: "アイデアを形にするところからスタート。小さな試作を重ね、取り組みの方向性を探りました。気づいたことや課題を記録し、対話を通じて整理しながら、次の挑戦につながる土台を築いていきました。", color: "#243048" },
	{ year: "2024", description: "最初のプロジェクトを公開。使う人の声を聞きながら、機能やデザインを少しずつ改善しました。実際の利用場面を確かめ、迷いやすい操作や伝わりにくい表現を見直すことで、日々の使いやすさを磨いていきました。", color: "#243048" },
	{ year: "2025", description: "新しい技術や表現に挑戦。これまでの経験を生かして、取り組みの幅を広げていきました。試行錯誤から得られた知識を共有し、異なる視点を取り入れることで、より豊かな提案につなげました。", color: "#243048" },
	{ year: "2026", description: "積み重ねてきたことを、次の一歩へ。より使いやすく、心地よい体験を目指して進んでいます。これまでの成果を振り返りながら、新たな課題にも丁寧に向き合い、長く使い続けられる仕組みを育てていきます。", color: "#243048" },
];
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Falling Cards — Timeline</title>
		<meta name="description" content="中央のタイムラインに沿って、年号と説明文を載せた4枚のカードが左右交互に落下します。" />
		<script is:inline>
			if (window.matchMedia("(min-width: 1024px)").matches && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				document.documentElement.classList.add("is-live");
			}
		</script>
	</head>
	<body>
		<SiteNav />
		<header class="masthead">
			<h1>Falling Cards — Timeline</h1>
			<p>年号と説明文を載せたカードが、タイムラインの左右に落ちてきます。</p>
		</header>
		<main>
			<section id="stage" class="timeline" aria-label="2023年から2026年までのタイムライン" data-drop-interval="320" data-drop-distance="0.25" data-selectable-physics="true" data-card-color="#243048">
				<div class="timeline-line" aria-hidden="true"></div>
				<ol class="timeline-list">
					{milestones.map((milestone) => (
						<li class="timeline-item" style={`--card-color: ${milestone.color}`}>
							<span class="timeline-node" aria-hidden="true"></span>
							<article class="pic timeline-card" data-soft-content>
								<h2><time datetime={milestone.year}>{milestone.year}</time></h2>
								<p>{milestone.description}</p>
							</article>
						</li>
					))}
				</ol>
				<span class="timeline-end" aria-hidden="true"></span>
			</section>
		</main>
		<noscript><style>html.is-live .timeline-card { visibility: visible; opacity: 1; transform: none; }</style></noscript>
		<script>import "../scripts/timeline.js";</script>
	</body>
</html>

<style is:global>
	*, *::before, *::after { box-sizing: border-box; }
	body { margin: 0; background: #fff; color: #1a1a1a; font-family: "Helvetica Neue", "Hiragino Sans", "Noto Sans JP", sans-serif; }
	.masthead { max-width: 1080px; margin: 0 auto; padding: 1.5rem 1.25rem 2rem; }
	.masthead h1 { margin: 0; font-size: 1rem; font-weight: 650; letter-spacing: 0.04em; }
	.masthead p { margin: 0.35rem 0 0; font-size: 0.82rem; line-height: 1.5; color: #555; }
	.timeline { --axis-gap: 80px; position: relative; max-width: 960px; margin: 0 auto 4rem; padding: 110px 24px 64px; }
	.timeline-line { position: absolute; top: 0; bottom: 0; left: calc(50% - 1px); width: 2px; background: #c9cecb; transform-origin: top center; }
	.timeline-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 28px; }
	.timeline-item { display: grid; grid-template-columns: minmax(0, 1fr) var(--axis-gap) minmax(0, 1fr); align-items: center; }
	.timeline-node { grid-column: 2; grid-row: 1; justify-self: center; position: relative; width: 12px; height: 12px; border: 3px solid #c9cecb; border-radius: 50%; background: #fff; }
	.timeline-node::before { content: ""; position: absolute; top: 2px; right: 9px; width: calc(var(--axis-gap) / 2 - 6px); height: 1px; background: #c9cecb; }
	.timeline-item:nth-child(even) .timeline-node::before { right: auto; left: 9px; }
	.timeline-card { position: relative; grid-column: 1; grid-row: 1; min-width: 0; padding: 24px 28px; color: #fff; background: var(--selected-card-color, var(--card-color)); border-radius: 8px; }
	.timeline-item:nth-child(even) .timeline-card { grid-column: 3; }
	.timeline-card h2 { margin: 0; font-size: 44px; line-height: 1; font-weight: 650; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
	.timeline-card p { margin: 16px 0 0; font-size: 16px; line-height: 1.8; overflow-wrap: anywhere; }
	.timeline-end { position: absolute; bottom: 0; left: calc(50% - 4px); width: 8px; height: 8px; background: #c9cecb; border-radius: 50%; }
	html.is-live .timeline-card { visibility: hidden; opacity: 0; transform: translate3d(0, -25%, 0) rotate(-2.25deg); transform-origin: center; will-change: transform, opacity; }
	html.is-live #stage[data-physics-mode="soft"] .timeline-card { visibility: visible; transform: none; will-change: auto; }
	.skin { position: absolute; inset: 0; z-index: 4; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
	.tp-dfwv { z-index: 30; width: min(280px, calc(100vw - 1.5rem)); }
	@media (max-width: 1023px) {
		.timeline { --axis-gap: 48px; padding-top: 40px; }
		.timeline-card { padding: 20px; }
		.timeline-card h2 { font-size: 36px; }
	}
	@media (max-width: 600px) {
		.timeline { --axis-gap: 28px; padding-inline: 12px; }
		.timeline-card { padding: 16px 12px; }
		.timeline-card h2 { font-size: 30px; }
		.timeline-card p { margin-top: 12px; line-height: 1.65; }
	}
</style>
