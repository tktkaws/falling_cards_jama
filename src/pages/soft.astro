---
import { cards } from "../scripts/cards.js";
import SiteNav from "../components/SiteNav.astro";
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Falling Cards — Soft</title>
		<script is:inline>
			const wide = window.matchMedia("(min-width: 1024px)").matches;
			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			if (wide && !reduce) document.documentElement.classList.add("is-live");
		</script>
		<style is:global>
			*, *::before, *::after { box-sizing: border-box; }
			html { background: #fff; --header-gap: 5rem; --row-gap: 100px; --drop-distance: 0.85; }
			body { margin: 0; background: #fff; color: #1a1a1a; font-family: "Helvetica Neue", "Hiragino Sans", "Noto Sans JP", sans-serif; }
			.masthead { max-width: 1080px; margin: 0 auto; padding: 1.5rem 1.25rem var(--header-gap); }
			.masthead h1 { margin: 0; font-size: 1rem; font-weight: 650; letter-spacing: .04em; }
			.masthead p { margin: .35rem 0 0; font-size: .82rem; line-height: 1.5; opacity: .72; }
			.grid { position: relative; display: grid; grid-template-columns: 1fr; row-gap: var(--row-gap); column-gap: 28px; max-width: 1080px; margin: 0 auto; padding-inline: 1.25rem; padding-bottom: 4rem; }
			.card { display: block; color: inherit; text-decoration: none; }
			.card:focus-visible { outline: 2px solid #1a1a1a; outline-offset: 4px; }
			.pic { position: relative; aspect-ratio: 35 / 14; overflow: hidden; border-radius: 5px; }
			.label { margin: 14px 0 0; font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif; font-size: clamp(.94rem, .4vw + .85rem, 1.125rem); line-height: 1.3; }
			.tags { display: flex; flex-wrap: wrap; gap: 5px; margin: 10px 0 0; padding: 0; list-style: none; }
			.tags li { display: flex; align-items: center; justify-content: center; border: 1px solid #1a1a1a; border-radius: 5px; padding: 4px 10px; font-size: .8rem; line-height: 1.2; }
			.name { margin: 1em 0 0; font-size: 1.3rem; line-height: 1.45; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 2px; }
			html.is-live .grid { padding-top: calc(var(--drop-distance) * (min(100%, 1080px) - 2.5rem - 56px) / 3 * 20 / 43); }
			html.is-live .pic { background: transparent !important; }
			.skin { position: absolute; inset: 0; z-index: 4; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
			.tp-dfwv { z-index: 30; width: min(280px, calc(100vw - 1.5rem)); }
			@media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } .pic { aspect-ratio: 43 / 20; } }
			@media (prefers-reduced-motion: reduce) { .skin { display: none; } }
		</style>
	</head>
	<body>
		<SiteNav />
		<header class="masthead"><h1>Falling Cards — Soft</h1><p>粒子がつながった柔らかなカードが、上から落ちて所定の位置に収まります。</p></header>
		<main><div id="stage" class="grid">
			{cards.map((card) => <a class="card" href="#" draggable="false">
				<div class="pic" style={`background:${card.bg};--card-bg:${card.bg}`}>
				</div>
				<p class="label">{card.date}</p><ul class="tags">{card.tags.map((tag) => <li>{tag}</li>)}</ul><p class="name">{card.title}</p>
			</a>)}
		</div></main>
		<noscript><style>html.is-live .pic { background: var(--card-bg) !important; } html.is-live .grid { padding-top: 0; }</style></noscript>
		<script>import "../scripts/soft.js";</script>
	</body>
</html>
